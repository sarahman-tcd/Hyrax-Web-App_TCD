<%# Custom license display: smart lookup and display logic %>
<% if presenter.license.present? %>
  
    <dt><%= t('hyrax.base.show.license') %></dt>
    <dd>
      <ul class="tabular">
        <% presenter.license.each do |license_value| %>
          <li class="attribute attribute-license">
            <% 
              # Smart lookup: check if this is a term or ID
              term_match = nil
              id_match = nil
              
              licenses_file = Rails.root.join('config', 'authorities', 'licenses.yml')
              if File.exist?(licenses_file)
                licenses_data = YAML.load_file(licenses_file)
                licenses_data['terms'].each do |term_data|
                  # Check if this is a term match
                  if term_data['term'] == license_value
                    term_match = term_data
                    break
                  end
                  # Check if this is an ID match
                  if term_data['id'] == license_value
                    id_match = term_data
                    break
                  end
                end
              end
              
              # Determine what to display
              if term_match
                # This is a term, so we have an ID to work with
                id = term_match['id']
                if id.start_with?('http://', 'https://')
                  # URL ID: show term as clickable link
                  display_text = term_match['term']
                  link_url = id
                else
                  # Text ID: show the ID text directly
                  display_text = id
                  link_url = nil
                end
              elsif id_match
                # This is already an ID
                if license_value.start_with?('http://', 'https://')
                  # URL ID: show term as clickable link
                  display_text = id_match['term']
                  link_url = license_value
                else
                  # Text ID: show directly
                  display_text = license_value
                  link_url = nil
                end
              else
                # No match found, show as is
                display_text = license_value
                link_url = nil
              end
            %>
            
            <% if link_url %>
              <%= link_to display_text, link_url, target: '_blank' %>
            <% else %>
              <%= display_text %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </dd>
  
<% end %>

<%= presenter.attribute_to_html(:copyright_note, html_dl: true) %>

<%= presenter.attribute_to_html(:copyright_status, html_dl: true) %>

