<script>
document.addEventListener("turbolinks:load", function () {
  const licenseDts = document.querySelectorAll("dt");

  licenseDts.forEach(function (dt) {
    if (dt.textContent.trim() === "License") {
      const dd = dt.nextElementSibling;
      if (dd && dd.tagName === "DD") {
        let licenseLink = dd.querySelector("a");
        let licenseText = dd.textContent.trim();

        // Check if CC logo already exists to prevent duplicates
        const existingLogo = dd.querySelector("img[src*='licensebuttons.net']");
        if (existingLogo) {
          return; // Logo already exists, skip processing
        }

        // If plain text CC-BY, convert it into a link + logo
        if (!licenseLink && (licenseText.includes("Creative Commons BY Attribution 4.0 International") || licenseText.toLowerCase().includes("creative commons by attribution 4.0 international"))) {
          dd.innerHTML = ""; // clear out existing text
          
          // Create wrapper structure: <ul><li>...</li></ul>
          const ul = document.createElement("ul");
          ul.className = "tabular";
          const li = document.createElement("li");
          li.className = "attribute attribute-license";

          // Create license link
          licenseLink = document.createElement("a");
          licenseLink.href = "https://creativecommons.org/licenses/by/4.0/";
          licenseLink.target = "_blank";
          licenseLink.textContent = "CC-BY";

          // Create CC logo
          const ccLogo = document.createElement("img");
          ccLogo.src = "https://licensebuttons.net/l/by/4.0/88x31.png";
          ccLogo.alt = "Creative Commons BY";
          ccLogo.style.marginLeft = "0.5em";
          ccLogo.style.marginBottom = "0.2em";

          // Append into structure
          li.appendChild(licenseLink);
          li.appendChild(ccLogo);
          ul.appendChild(li);
          dd.appendChild(ul);
        }

        // If an existing link already there, reformat into UL > LI
        else if (licenseLink) {
          const hrefMatch = licenseLink.getAttribute("href") === "https://creativecommons.org/licenses/by/4.0/";
          const textMatch = licenseLink.textContent.trim().includes("Creative Commons BY Attribution 4.0 International");

          if (hrefMatch || textMatch) {
            // Standardize text and href
            licenseLink.href = "https://creativecommons.org/licenses/by/4.0/";
            licenseLink.target = "_blank";
            licenseLink.textContent = "CC-BY";

            // Create CC logo
            const ccLogo = document.createElement("img");
            ccLogo.src = "https://licensebuttons.net/l/by/4.0/88x31.png";
            ccLogo.alt = "Creative Commons BY";
            ccLogo.style.marginLeft = "0.5em";
            ccLogo.style.marginBottom = "0.2em";

            // Wrap into UL/LI structure if not already
            if (!dd.querySelector("ul")) {
              const ul = document.createElement("ul");
              ul.className = "tabular";
              const li = document.createElement("li");
              li.className = "attribute attribute-license";

              li.appendChild(licenseLink.cloneNode(true));
              li.appendChild(ccLogo);
              ul.appendChild(li);

              dd.innerHTML = "";
              dd.appendChild(ul);
            } else {
              // Only append logo if it doesn't already exist
              if (!dd.querySelector("img[src*='licensebuttons.net']")) {
                licenseLink.parentNode.appendChild(ccLogo);
              }
            }
          }
        }
      }
    }
  });
});
</script>
