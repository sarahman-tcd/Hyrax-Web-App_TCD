<%= form_tag search_form_action, method: :get, class: "form-horizontal search-form", id: "search-form-header", role: "search" do %>
  <div class="form-group">
    <h1 class="fancy-label">Explore Digital Collections</h1>
    <div class="form-group simple-search-panel">
      <div class="input-group full-width-search " >
        <div style="position: relative; display: inline-block; width: 100%;">
          <%= text_field_tag :q, current_search_parameters, class: "q form-control", id: "search-field-header", placeholder: "Search Entire Collection" %>
          
          <i class="fa fa-info-circle" data-toggle="tooltip" title="Please avoid using special characters (e.g., @, #, $, %, &, -, +, *)"
            style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #6a6a6a8f; z-index: 100;font-size: large;"></i>
        </div>
        <button type="submit" class="search-button" id="search-submit-header" data-toggle="tooltip" title="Search">
          <i class="fa fa-search"></i>
        </button>
      </div>
    </div>
  </div>

 

   <div class="advanced-search-panel" style="display: none;">
      <div class="dynamic-queries-container">
        <div class="q-line-static " id="dynamic-search-rows">
          <div class="row search-row">
            <div class="form-group" style="padding-right:15px; padding-left:15px ">
              <label>Created Between</label><br>
              <canvas id="timeline-canvas" width="885" height="50" style="padding-right:5px; padding-left:0px "></canvas>
            </div>

            <br><br>
        
            <div class="col-sm-3">
            <select name="search_field[]" class="form-control field-dropdown">
            <option value="any">Any Field</option>
            <option value="abstract_tesim">Abstract</option>
            <option value="contributor_tesim">Creator / Contributor</option>
            <option value="copyright_note_tesim">Copyright note</option>
            <option value="digital_object_identifier_tesim">DOI</option>
            <option value="keyword_tesim">Keyword / Subject</option>
            <option value="publisher_tesim">Publisher</option>
            <option value="identifier_tesim">Shelf Mark/Reference Number</option>
            <option value="title_tesim">Title</option>
              </select>
            </div>
            <div class="col-sm-3">
              <select name="search_operator[]" class="form-control operator-dropdown">
                <option value="contains">Contains</option>
                <option value="starts_with">Starts With</option>
                <option value="equal">Exact</option>
              </select>
            </div>
            <div class="col-sm-6">
              <%= text_field_tag "search_query[]", nil, class: "q form-control", placeholder: "Search term" %>            
            </div>
          </div>
        </div>
      </div>

      <div class="form-group" >
        <label  id="add-line"  class="btn clickable-add-option"><i class="fa fa-plus"></i> Add New Search</label>  
        <label id="clear-all"
              class="btn clickable-clear-option"
              data-redirect-url="<%= main_app.search_catalog_path %>">
          <i class="fa fa-refresh"></i> Clear All
        </label>
      </div>
      
      <br>

      <div class="advanced-search-filters">     
      
        
        <div class="row">
          <div class="col-sm-6"> 
            <div class="form-group" style="text-align: left;" >
              <label for="toggle-simple-search" style="padding-bottom: 20px;">Go back to</label>
              <button type="button" id="toggle-simple-search"  class="btn clickable-label">Quick Search</button>
            </div>
          </div> 

          <div class="col-sm-6">
            <div class="form-group" style="text-align: right;" >
              <button type="submit" class="btn advance-search-button btn-primary"  id="search-button" style="">
                <i class="fa fa-search"></i> Search
              </button>
            </div> 
          </div>

        </div> 
      
      </div>  
    </div>   


  
  <div class="form-group simple-search-panel" id="advance-search-option">
    <label for="toggle-advanced-search" style="padding-bottom: 20px;">Discover more with</label>
    <button type="button" id="toggle-advanced-search"  class="btn clickable-label">Advanced Search</button>
  </div>
<% end %>

<!-- jQuery UI for Autocomplete -->
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

<script>
document.addEventListener("turbolinks:load", function () {

      $('#search-field-header').removeAttr('value');
      
      // Add Enter key support for advanced search inputs
      document.addEventListener('keypress', function(e) {
        // Check if Enter key was pressed
        if (e.key === 'Enter' || e.keyCode === 13) {
          // Check if the target is a search input field in advanced search
          if (e.target.classList.contains('q') || 
              e.target.id === 'search-field-header') {
            e.preventDefault();
            // Submit the search form
            document.getElementById('search-form-header').submit();
          }
        }
      });
      
      //Placeholder Animation
      const searchField = document.getElementById("search-field-header");
      
      //const placeholderText = "Search Entire Collection";
      let index = 0;
      //$("#search-field-header").attr("placeholder", "");

      //const intervalId = setInterval(() => {
      //  if (index < placeholderText.length) {
      //    searchField.placeholder += placeholderText[index];
      //    index++;
      //  } else {
      //    clearInterval(intervalId);
      //  }
      //}, 120); 

      //Search Info Tooltip
      $('[data-toggle="tooltip"]').tooltip();

      //Toggle the Advance Search Option
      const advancedPanel = document.querySelector(".advanced-search-panel");
      const toggleAdvancedSearch = document.getElementById("toggle-advanced-search");

      const simplePanel = document.querySelector(".simple-search-panel");
      const toggleSimpleSearch = document.getElementById("toggle-simple-search");
      

      toggleAdvancedSearch.addEventListener("click", function() {
          $('#advance-search-option').hide();
          simplePanel.style.display = "none";
          advancedPanel.style.display = 'block';
      });

      toggleSimpleSearch.addEventListener("click", function() {
          advancedPanel.style.display = 'none';
          simplePanel.style.display = "block";
          $('#advance-search-option').show();
      });
    

      const addButton = document.getElementById("add-line");
      const dynamicContainer = document.querySelector(".dynamic-queries-container");
      let addCount = 1;
      const maxAddCount = 10;

      const addNewLineHTML = `
        <div class="row search-row">
          <div class="col-sm-2">
            <select name="search_logic[]" class="form-control logic-dropdown">
              <option value="AND">AND</option>
              <option value="OR">OR</option>
              <option value="NOT">NOT</option>
            </select>
          </div>
          <div class="col-sm-3">
            <select name="search_field[]" class="form-control field-dropdown">
              <option value="any">Any Field</option>
              <option value="abstract_tesim">Abstract</option>
              <option value="contributor_tesim">Creator / Contributor</option>
              <option value="copyright_note_tesim">Copyright note</option>
              <option value="digital_object_identifier_tesim">DOI</option>
              <option value="keyword_tesim">Keyword / Subject</option>
              <option value="publisher_tesim">Publisher</option>
              <option value="identifier_tesim">Shelf Mark/Reference Number</option>
              <option value="title_tesim">Title</option>
            </select>
          </div>
          <div class="col-sm-3">
            <select name="search_operator[]" class="form-control operator-dropdown">
              <option value="contains">Contains</option>
              <option value="starts_with">Starts With</option>
              <option value="equal">Exact</option>
            </select>
          </div>
          <div class="col-sm-3">
              <%= text_field_tag "search_query[]", nil, class: "q form-control", placeholder: "Search term" %>            

          </div>
          
        <div class="col-sm-1">
            <button type="button" class="btn btn-clear-line" style="color: #fff; background-color: #ff76762b; border: 1px solid #ff9393;">
              <i class="fa fa-trash-o" style="font-size:20px;"></i>
            </button>
          </div>
        </div>


    `;

    // Safe setup with a flag
      if (!addButton.dataset.listenerAttached) {
        addButton.addEventListener("click", function() {
          if (addCount < maxAddCount) {
            const newLineHTML = `<div class="query-line" id="dynamic-search-rows">` + addNewLineHTML + `</div>`;
            dynamicContainer.insertAdjacentHTML("beforeend", newLineHTML);
            addCount++;
          } else {
            alert("You can only add up to 10 search lines.");
          }
        });

        // Mark as attached so this block doesn't run again
        addButton.dataset.listenerAttached = "true";
      }



      dynamicContainer.addEventListener("click", function(e) {
          const removeButton = e.target.closest(".btn-clear-line");
          if (removeButton) {
              const queryLine = removeButton.closest(".query-line");
              if (queryLine) {
                  queryLine.remove();
                  if (addCount > 0) addCount--;
              }
          }
      });


      const canvas = document.getElementById("timeline-canvas");
      const ctx = canvas.getContext("2d");

      const minYear = -2500;
      const maxYear = new Date().getFullYear();
      console.log('Date range slider - Current year (maxYear):', maxYear);
      const initialStartYear = 1150;
      const initialEndYear = 1950;

      // Non-linear scale parameters
      // This gives more precision to recent years while maintaining full historical range
      const zoomPoint = 1800; // Year where we start expanding precision
      const compressionFactor = 0.15; // How much to compress older years (0-1, lower = more compression)
      const expansionFactor = 0.65; // How much of the slider to use for recent years (1800+)

      // Get the actual rendered width of the canvas
      function getCanvasWidth() {
          return canvas.getBoundingClientRect().width || canvas.width;
      }

      // Convert year to slider position (non-linear)
      function yearToPosition(year) {
          const canvasWidth = getCanvasWidth();
          const totalRange = maxYear - minYear;
          const normalizedYear = (year - minYear) / totalRange; // 0 to 1
          
          if (year <= zoomPoint) {
              // Older years: use compressed scale with power function
              const zoomPointNormalized = (zoomPoint - minYear) / totalRange;
              const yearRatio = normalizedYear / zoomPointNormalized; // 0 to 1 for older years
              // Use power function to compress older years
              const compressedRatio = Math.pow(yearRatio, 1.5); // Adjust exponent for more/less compression
              return compressedRatio * zoomPointNormalized * (1 - expansionFactor) * canvasWidth;
          } else {
              // Recent years: use expanded linear scale
              const zoomPointNormalized = (zoomPoint - minYear) / totalRange;
              const recentRange = 1 - zoomPointNormalized;
              const yearRatio = (normalizedYear - zoomPointNormalized) / recentRange; // 0 to 1 for recent years
              const startPosition = zoomPointNormalized * (1 - expansionFactor) * canvasWidth;
              const expandedRange = expansionFactor * canvasWidth;
              return startPosition + yearRatio * expandedRange;
          }
      }

      // Convert slider position to year (inverse of yearToPosition)
      function positionToYear(position) {
          const canvasWidth = getCanvasWidth();
          const totalRange = maxYear - minYear;
          const zoomPointNormalized = (zoomPoint - minYear) / totalRange;
          const oldYearsEndPosition = zoomPointNormalized * (1 - expansionFactor) * canvasWidth;
          
          if (position <= oldYearsEndPosition) {
              // Older years: reverse the compression
              const compressedRatio = position / oldYearsEndPosition;
              const yearRatio = Math.pow(compressedRatio, 1 / 1.5); // Inverse of power function
              const normalizedYear = yearRatio * zoomPointNormalized;
              return Math.round(normalizedYear * totalRange + minYear);
          } else {
              // Recent years: reverse the expansion
              const startPosition = oldYearsEndPosition;
              const expandedRange = expansionFactor * canvasWidth;
              const yearRatio = (position - startPosition) / expandedRange;
              const recentRange = 1 - zoomPointNormalized;
              const normalizedYear = zoomPointNormalized + yearRatio * recentRange;
              const calculatedYear = Math.round(normalizedYear * totalRange + minYear);
              // Ensure we never exceed maxYear
              return Math.min(calculatedYear, maxYear);
          }
      }

      // Initialize pointers at the middle range
      const startPointer = {
          x: yearToPosition(initialStartYear),
          y: 25,
          label: initialStartYear < 0 ? Math.abs(initialStartYear) + " BCE" : initialStartYear+ " CE",
      };
    
      const endPointer = {
          x: yearToPosition(initialEndYear),
          y: 25,
          label: initialEndYear < 0 ? Math.abs(initialEndYear) + " BCE" : initialEndYear + " CE",
      };

      function updateYearLabels() {
          // Calculate the start and end year based on the pointer positions
          const startYear = positionToYear(startPointer.x);
          const endYear = positionToYear(endPointer.x);

          // Function to format the year as BCE or CE
          function formatYear(year) {
              if (year <= 0) {
                  return Math.abs(year) + " BCE";  // Display BCE for negative years
              } else {
                  return year + " CE";  // Display CE for positive years
              }
          }

          // Update the labels to show the formatted years
          startPointer.label = formatYear(startYear);
          endPointer.label = formatYear(endYear);
      }


      function drawSlider() {
          ctx.clearRect(0, 0, canvas.width, canvas.height);

          // Draw timeline background for the entire slider
          const radius = 6; // Adjust this value for more or less rounding

          ctx.fillStyle = "#f0f0f0"; // Light gray background outside the range
          
          // Draw rounded rectangle manually
          ctx.beginPath();
          ctx.moveTo(radius, startPointer.y - 5); // Start from the left rounded corner
          ctx.lineTo(canvas.width - radius, startPointer.y - 5); // Top edge
          ctx.arc(canvas.width - radius, startPointer.y + 1, radius, Math.PI * 1.5, Math.PI * 0.5, false); // Right rounded edge
          ctx.lineTo(radius, startPointer.y + 7); // Bottom edge
          ctx.arc(radius, startPointer.y + 1, radius, Math.PI * 0.5, Math.PI * 1.5, false); // Left rounded edge
          ctx.closePath();
          ctx.fill();
          

          // Draw timeline background for the selected range with gradient
          const gradient = ctx.createLinearGradient(startPointer.x, 0, endPointer.x, 0);
          gradient.addColorStop(0, "#667eea");    // Purple
          gradient.addColorStop(0.5, "#4facfe");  // Blue
          gradient.addColorStop(1, "#00f2fe");    // Cyan
          ctx.fillStyle = gradient;
          ctx.fillRect(startPointer.x, startPointer.y - 5, endPointer.x - startPointer.x, 12);

          // Draw start pointer with gradient
          const startGradient = ctx.createRadialGradient(startPointer.x, startPointer.y, 0, startPointer.x, startPointer.y, 10);
          startGradient.addColorStop(0, "#667eea");
          startGradient.addColorStop(1, "#764ba2");
          ctx.fillStyle = startGradient;
          ctx.beginPath();
          ctx.arc(startPointer.x, startPointer.y, 10, 0, Math.PI * 2);
          ctx.fill();
          
          // Add white border to pointer
          ctx.strokeStyle = "#fff";
          ctx.lineWidth = 2;
          ctx.stroke();

          // Draw end pointer with gradient
          const endGradient = ctx.createRadialGradient(endPointer.x, endPointer.y, 0, endPointer.x, endPointer.y, 10);
          endGradient.addColorStop(0, "#00f2fe");  // Cyan
          endGradient.addColorStop(1, "#4facfe");  // Blue
          ctx.fillStyle = endGradient;
          ctx.beginPath();
          ctx.arc(endPointer.x, endPointer.y, 10, 0, Math.PI * 2);
          ctx.fill();
          
          // Add white border to pointer
          ctx.strokeStyle = "#fff";
          ctx.lineWidth = 2;
          ctx.stroke();

          // Draw labels
          ctx.fillStyle = "#fff";
          ctx.font = "bolder 14px Arial";

          const textPadding = 5; // Padding to prevent edge clipping
          const minLabelSpacing = 20; // Minimum distance between labels

          // Measure text widths
          const textWidthStart = ctx.measureText(startPointer.label).width;
          const textWidthEnd = ctx.measureText(endPointer.label).width;

          // Default positions
          let startX = startPointer.x - textWidthStart / 2;
          let endX = endPointer.x - textWidthEnd / 2;

          // Prevent labels from going outside the div
          if (startX < textPadding) startX = textPadding;
          if (startX + textWidthStart > canvas.width - textPadding) startX = canvas.width - textWidthStart - textPadding;

          if (endX < textPadding) endX = textPadding;
          if (endX + textWidthEnd > canvas.width - textPadding) endX = canvas.width - textWidthEnd - textPadding;

          // **Avoid Overlapping Labels**
          if (endX < startX + textWidthStart + minLabelSpacing) {
              let overlapAdjustment = (startX + textWidthStart + minLabelSpacing) - endX;
              endX += overlapAdjustment / 2;
              startX -= overlapAdjustment / 2;
          }

          // Draw text after adjustments
          ctx.fillText(startPointer.label, startX, startPointer.y - 15);
          ctx.fillText(endPointer.label, endX, endPointer.y - 15);


      }


      function dragPointer(e, pointer) {
          const rect = canvas.getBoundingClientRect();
          const minLeft = 0;
          const maxLeft = getCanvasWidth();

          function onMouseMove(event) {
              let newX = event.clientX - rect.left;
              newX = Math.min(Math.max(newX, minLeft), maxLeft);

              if (pointer === startPointer) {
                  const endX = endPointer.x;
                  if (newX >= endX) {
                      newX = endX - 1;
                  }
              } else {
                  const startX = startPointer.x;
                  if (newX <= startX) {
                      newX = startX + 1;
                  }
              }

              pointer.x = newX;
              updateYearLabels();
              drawSlider();
          }

          function onMouseUp() {
              document.removeEventListener("mousemove", onMouseMove);
              document.removeEventListener("mouseup", onMouseUp);
          }

          document.addEventListener("mousemove", onMouseMove);
          document.addEventListener("mouseup", onMouseUp);
      }

      canvas.addEventListener("mousedown", function(e) {
          const distStart = Math.abs(e.clientX - canvas.getBoundingClientRect().left - startPointer.x);
          const distEnd = Math.abs(e.clientX - canvas.getBoundingClientRect().left - endPointer.x);

          if (distStart < distEnd) {
              dragPointer(e, startPointer);
          } else {
              dragPointer(e, endPointer);
          }
      });

      // Sync canvas internal width with rendered width for proper scaling
      function syncCanvasSize() {
          const renderedWidth = canvas.getBoundingClientRect().width;
          if (renderedWidth && renderedWidth > 0 && renderedWidth !== canvas.width) {
              // Get current year values before resizing
              const startYear = positionToYear(startPointer.x);
              const endYear = positionToYear(endPointer.x);
              
              // Update canvas internal width (this resets the context)
              canvas.width = renderedWidth;
              
              // Recalculate pointer positions with new width
              startPointer.x = yearToPosition(startYear);
              endPointer.x = yearToPosition(endYear);
          }
      }

      // Initial setup
      syncCanvasSize();
      updateYearLabels();
      drawSlider();

      // Handle window resize
      let resizeTimeout;
      window.addEventListener('resize', function() {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(function() {
              syncCanvasSize();
              drawSlider();
          }, 100);
      });

      const searchButton = document.getElementById('search-button');
      const rowsContainer = document.getElementById('dynamic-search-rows');

      function restoreSearchFields() {
        const savedSearchFields = localStorage.getItem("savedSearchFields");
        const savedPanelState = localStorage.getItem("advancedPanelState");
        const savedTimeRange = localStorage.getItem("savedTimeRange");
    
        // Restore search fields values
        if (savedSearchFields) {
            const searchFieldsData = JSON.parse(savedSearchFields);
            const dynamicContainer = document.getElementById("dynamic-search-rows");
    
            // Ensure we have enough rows
            while (document.querySelectorAll(".search-row").length < searchFieldsData.length) {
                addSearchRow(); // Add new row dynamically
            }
    
            document.querySelectorAll(".search-row").forEach((row, index) => {
                if (searchFieldsData[index]) {
                    const fieldData = searchFieldsData[index];
    
                    // Check for logic dropdown (skip for the first row)
                    const logicDropdown = row.querySelector(".logic-dropdown");
                    if (logicDropdown) {
                        logicDropdown.value = fieldData.logic;
                    }
    
                    const fieldDropdown = row.querySelector(".field-dropdown");
                    if (fieldDropdown) {
                        fieldDropdown.value = fieldData.field;
                    }
    
                    const operatorDropdown = row.querySelector(".operator-dropdown");
                    if (operatorDropdown) {
                        operatorDropdown.value = fieldData.operator;
                    }
    
                    const queryInput = row.querySelector(".q");
                    if (queryInput) {
                        queryInput.value = fieldData.query;
                    }
                }
            });
        }
    
        // Restore Advanced Search Panel visibility
        if (savedPanelState === "open") {
            advancedPanel.style.display = "block";
            simplePanel.style.display = "none";
            document.getElementById("advance-search-option").style.display = "none";
        }
    
        // Restore time slider values
        if (savedTimeRange) {
            const [startYear, endYear] = JSON.parse(savedTimeRange);
    
            // Update the pointers based on saved values using non-linear scale
            startPointer.x = yearToPosition(startYear);
            endPointer.x = yearToPosition(endYear);
    
            // Update labels and redraw the slider
            updateYearLabels();
            drawSlider();
        }
    }
    
    // Function to extract the correct year value from the label
    function extractYearFromLabel(label) {
        let year = parseInt(label);  // Extract the numeric part of the label

        if (label.includes("BCE")) {
            return -Math.abs(year);  // If BCE, return a negative year
        } else if (label.includes("CE")) {
            return Math.abs(year);  // If CE, return the positive year
        }
        
        return year;  // In case of no label, return the year as it is
    }

    function addSearchRow() {
      const dynamicContainer = document.getElementById("dynamic-search-rows");

      

      if (addCount < maxAddCount) {
        const newLineHTML= ` <div class="query-line" id="dynamic-search-rows" style="margin-top:15px"">` + addNewLineHTML + `</div>`;
            

          // Append to container
          dynamicContainer.insertAdjacentHTML("beforeend", newLineHTML);
          addCount++;

          // Hide logic dropdown for the first row
          const allRows = dynamicContainer.querySelectorAll(".search-row");
          if (allRows.length === 1) {
              allRows[0].querySelector(".logic-dropdown").style.display = "none";
          }

          // Add event listener for the remove button
          const removeButtons = document.querySelectorAll(".remove-btn");
          removeButtons.forEach(button => {
              button.onclick = function () {
                  this.closest(".search-row").remove();
                  addCount--;
              };
          });
      } else {
          alert("You can only add up to 10 search lines.");
      }
   }


    function saveSearchFields() {
      const searchFieldsData = [];
  
      document.querySelectorAll(".search-row").forEach((row) => {
          const logic = row.querySelector(".logic-dropdown") ? row.querySelector(".logic-dropdown").value : '';
          const field = row.querySelector(".field-dropdown").value;
          const operator = row.querySelector(".operator-dropdown").value;
          const query = row.querySelector(".q").value;
  
          searchFieldsData.push({ logic, field, operator, query });
      });
  
      // Save search fields data
      localStorage.setItem("savedSearchFields", JSON.stringify(searchFieldsData));
  
      // Save time range values
      const startPointerLabel= extractYearFromLabel(startPointer.label);
      const endPointerLabel= extractYearFromLabel(endPointer.label);
      const savedTimeRange = JSON.stringify([startPointerLabel, endPointerLabel]);
      localStorage.setItem("savedTimeRange", savedTimeRange);
  
      // Save advanced panel state
      localStorage.setItem("advancedPanelState", advancedPanel.style.display === "block" ? "open" : "closed");
    }
  
  

    

    function getSearchParams() {
      let combinedQuery = '';
      
      document.querySelectorAll(".search-row").forEach((row, index) => {
          let logic = row.querySelector(".logic-dropdown") ? row.querySelector(".logic-dropdown").value : ''; 
          let field = row.querySelector(".field-dropdown").value;
          let operator = row.querySelector(".operator-dropdown").value;
          let query = row.querySelector(".q").value.trim();
  
          // Skip empty queries
        if (!query) return;

        // Apply correct formatting based on the operator
        // Handle multi-word queries and operators properly
        if (operator === 'contains') {
            // For contains: just wrap in wildcards (don't use quotes for multi-word)
            query = `*${query}*`;
        } else if (operator === 'starts_with') {
            // For starts_with: do NOT add wildcard here, it's added later
            // But we DO need to escape spaces for Solr string fields
            query = query.replace(/ /g, '\\ ');
        } else if (operator === 'equal') {
            // For exact: always wrap in quotes
            query = `"${query}"`;
        }

        let queryPart;
        
        // Helper to get correct field name for starts_with
        const getFieldForOperator = (fieldName, op) => {
            if (op !== 'starts_with') return fieldName;
            
            // Map of fields that have string (_sim) versions suitable for prefix search
            const simFieldMap = {
                'title_tesim': 'title_sim',
                'creator_tesim': 'creator_sim',
                'contributor_tesim': 'contributor_sim',
                'keyword_tesim': 'keyword_sim',
                'publisher_tesim': 'publisher_sim',
                'subject_tesim': 'subject_sim',
                'language_tesim': 'language_sim',
                'genre_tesim': 'genre_sim',
                'resource_type_tesim': 'resource_type_sim'
            };
            
            return simFieldMap[fieldName] || fieldName;
        };

        // Handle "any" field - search across all fields
        if (field === 'any') {
            const allFields = [
                'abstract_tesim',
                'contributor_tesim',
                'creator_tesim',
                'keyword_tesim',
                'subject_tesim',
                'publisher_tesim',
                'identifier_tesim',
                'title_tesim',
                'copyright_note_tesim',
                'digital_object_identifier_tesim'
            ];
            
            if (operator === 'contains') {
                // Split into words and search each word across all fields
                const words = query.trim().split(/\s+/);
                const wordQueries = words.map(word => {
                    const fieldQueries = allFields.map(f => `${f}:*${word}*`).join(' OR ');
                    return `(${fieldQueries})`;
                });
                queryPart = wordQueries.join(' AND ');
            } else if (operator === 'starts_with') {
                // For starts_with: use prefix query on _sim fields where available
                const fieldQueries = allFields.map(f => {
                    const searchField = getFieldForOperator(f, operator);
                    // Only escape spaces if we switched to a _sim field
                    const val = (searchField !== f) ? query.replace(/ /g, '\\ ') : query;
                    return `${searchField}:${val}*`;
                }).join(' OR ');
                queryPart = `(${fieldQueries})`;
            } else if (operator === 'equal') {
                // For exact: use phrase query
                const fieldQueries = allFields.map(f => `${f}:"${query}"`).join(' OR ');
                queryPart = `(${fieldQueries})`;
            }
        }
        // Special handling for combined facets
        else if (field === "contributor_tesim") {
            if (operator === 'contains') {
                const words = query.replace(/\*/g, '').trim().split(/\s+/);
                const wordQueries = words.map(word => 
                    `(contributor_tesim:*${word}* OR creator_tesim:*${word}*)`
                );
                queryPart = wordQueries.join(' AND ');
            } else if (operator === 'starts_with') {
                queryPart = `(contributor_sim:${query}* OR creator_sim:${query}*)`;
            } else {
                queryPart = `(contributor_tesim:${query} OR creator_tesim:${query})`;
            }
        } else if (field === "keyword_tesim") {
            if (operator === 'contains') {
                const words = query.replace(/\*/g, '').trim().split(/\s+/);
                const wordQueries = words.map(word => 
                    `(keyword_tesim:*${word}* OR subject_tesim:*${word}*)`
                );
                queryPart = wordQueries.join(' AND ');
            } else if (operator === 'starts_with') {
                queryPart = `(keyword_sim:${query}* OR subject_sim:${query}*)`;
            } else {
                queryPart = `(keyword_tesim:${query} OR subject_tesim:${query})`;
            }
        } else {
            // Single specific field
            if (operator === 'contains') {
                const words = query.replace(/\*/g, '').trim().split(/\s+/);
                const wordQueries = words.map(word => `${field}:*${word}*`);
                queryPart = `(${wordQueries.join(' AND ')})`;
            } else {
                const searchField = getFieldForOperator(field, operator);
                const val = operator === 'starts_with' ? `${query}*` : query;
                queryPart = `(${searchField}:${val})`;
            }
        }

        // Append logic only from the second row onward
        if (index > 0 && logic) {
            combinedQuery += ` ${logic} `;
        }

        combinedQuery += queryPart;
      });
  
      // Fetch time range values from the timeline slider
      const startYear = extractYearFromLabel(startPointer.label);
      const endYear = extractYearFromLabel(endPointer.label);
  
      if (combinedQuery) {
          combinedQuery += " AND ";
      }
  
      // Append time range filter to query (include records without dates)
      combinedQuery += `(date_created_tesim:[${startYear} TO ${endYear}] OR (*:* NOT date_created_tesim:*))`;
  
      return new URLSearchParams({ q: combinedQuery }).toString();
  }
  
  

  

    // Advance search button click
    searchButton.addEventListener('click', function(event) {
        event.preventDefault();
        saveSearchFields();
        let searchParams = getSearchParams();
        let currentPath = window.location.pathname;
        
        if (currentPath !== "/catalog") {
            restoreSearchFields();
            // Redirect to /catalog but keep input values
            let newUrl = "/catalog?" + searchParams;
            history.pushState(null, "", newUrl);
            window.location.href = newUrl;
        } else {
            restoreSearchFields();
            // If already on /catalog, update the URL and reload without full refresh
            let newUrl = "/catalog?" + searchParams;
            history.pushState(null, "", newUrl);
            window.location.assign(newUrl);            
        }
    });


    // Keep search fields populated after page load
    function restoreSearchFields_old() {
        let params = new URLSearchParams(window.location.search);
        let query = params.get('q');

        if (query) {
            let conditions = query.split(/ (AND|OR) /); // Splitting query by logic operators

            document.querySelectorAll(".search-row").forEach((row, index) => {
                if (conditions[index]) {
                    let match = conditions[index].match(/\((.*?):(.*?)\)/);
                    if (match) {
                        let field = match[1];
                        let queryValue = match[2];

                        row.querySelector(".field-dropdown").value = field;
                        row.querySelector(".q").value = queryValue.replace(/\*/g, ''); // Remove wildcards
                    }
                }
            });
        }
    }

    restoreSearchFields(); // Restore fields when page loads

    // Preserve search results when using back/forward navigation
    window.addEventListener("popstate", function() {
        restoreSearchFields();
        location.reload(); // Reload but keep input values
    });

    // Clear All button event
    const clearAllButton = document.getElementById("clear-all");

    clearAllButton.addEventListener("click", function() {
        // Clear all saved data from localStorage
        localStorage.removeItem("savedSearchFields");
        localStorage.removeItem("savedTimeRange");
        localStorage.removeItem("advancedPanelState");

        // Optionally clear the search fields (if needed)
        document.querySelectorAll(".search-row").forEach((row) => {
            //row.querySelector(".logic-dropdown").value = 'AND'; // or reset to default value
            row.querySelector(".field-dropdown").value = 'any'; // or reset to default field
            row.querySelector(".operator-dropdown").value = 'contains'; // or reset to default operator
            row.querySelector(".q").value = ''; // reset search input
        });

        // Clear the time slider to the default state using non-linear scale
        startPointer.x = yearToPosition(initialStartYear);
        endPointer.x = yearToPosition(initialEndYear);
        updateYearLabels();
        drawSlider();

        // Reset the panel to the simple view
        advancedPanel.style.display = 'none';
        simplePanel.style.display = 'block';
        document.getElementById("advance-search-option").style.display = 'block';

        // Redirect to catalog root to show all records
        const url = clearAllButton.getAttribute("data-redirect-url");
        if (url) {
          window.location.href = url;
        }
    });

   


  });

</script>


