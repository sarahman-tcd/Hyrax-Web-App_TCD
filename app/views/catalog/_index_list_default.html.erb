<div class="col-md-12">
  <div class="ajax-result-card">
    <%# Thumbnail Section %>
    <div class="ajax-thumbnail-container">
      <% if document.thumbnail_path.present? %>
        <%= link_to url_for_document(document) do %>
          <%= image_tag document.thumbnail_path, class: "ajax-thumbnail", alt: document.title_or_label %>
        <% end %>
      <% else %>
        <%= link_to url_for_document(document), class: "placeholder-thumbnail" do %>
          <span class="glyphicon glyphicon-file placeholder-icon"></span>
        <% end %>
      <% end %>
    </div>

    <%# Content Section %>
    <div class="ajax-content">
      <h3 class="ajax-title">
        <%= link_to document.title_or_label, url_for_document(document) %>
      </h3>

      <div class="ajax-metadata">
        <% doc_presenter = index_presenter(document) %>
        
        <%# Creator %>
        <% if document['creator_tesim'].present? %>
          <div class="ajax-meta-row">
            <span class="ajax-label">Creator:</span>
            <span class="ajax-value truncate-3-lines" title="<%= document['creator_tesim'].join(', ') %>">
              <%= document['creator_tesim'].join(', ') %>
            </span>
          </div>
        <% end %>

        <%# Date Created %>
        <% if document['date_created_tesim'].present? %>
          <div class="ajax-meta-row">
            <span class="ajax-label">Date Created:</span>
            <span class="ajax-value truncate-3-lines" title="<%= document['date_created_tesim'].join(', ') %>">
              <%= document['date_created_tesim'].join(', ') %>
            </span>
          </div>
        <% end %>

        <%# Resource Type %>
        <% if document['resource_type_tesim'].present? %>
          <div class="ajax-meta-row">
            <span class="ajax-label">Resource Type:</span>
            <span class="ajax-value truncate-3-lines" title="<%= document['resource_type_tesim'].join(', ') %>">
              <%= document['resource_type_tesim'].join(', ') %>
            </span>
          </div>
        <% end %>

        <%# Collection Counts & Tile Order (Preserved from original) %>
        <% if(doc_presenter.field_value('has_model_ssim') == 'Collection') %>
          <% collection_presenter = Hyrax::CollectionPresenter.new(document, current_ability) %>
          <div class="collection-counts-wrapper" style="margin-top: 10px;">
            <div class="collection-counts-item">
              <span><%= collection_presenter.total_viewable_collections %></span>Collections
            </div>
            <div class="collection-counts-item">
              <span><%= collection_presenter.total_viewable_works %></span>Works
            </div>

            <% if user_signed_in?%>
            <div class="collection-counts-item tileOrderContainer">            
                <span class="addText" id="<%= doc_presenter.field_value('id').parameterize %>" style="display:inline-block;">Add</span>
                <input type="text" class="text-box" style="display: none; width: 25px;">
                <br>
                Tile Order 
            </div> 
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>


