      }
    }
  });
  %>
</script>

<script>
  document.addEventListener("turbolinks:load", function () {
      setTimeout(() => {
        $('.filterName, .filterValue').each(function () {
          const rawText = $(this).text().replace(/\s+/g, ' ').trim();
          const anyMatch = rawText.match(/^\["any"\]\s*(.*)$/i);
          if (anyMatch) {
            const valueOnly = anyMatch[1].trim();
            const className = $(this).attr('class');

            if (className.includes('filterName')) {
              $(this).text('Any');
            } else if (className.includes('filterValue')) {
              $(this).text(valueOnly).attr('title', valueOnly);
            }
          }
        });
      }, 500); 


      // Find all the constraint-value spans
      const constraintSpans = document.querySelectorAll('.constraint-value');

      constraintSpans.forEach(function (span) {
          // Get the raw query text directly from the span
          const rawSearchParams = span.textContent.trim(); // Extract text content
        
          if (rawSearchParams) {
              // Convert the raw search params to human-readable format
              const humanReadable = humanReadableFilters(rawSearchParams);

              // Find the elements where we want to update the text
              const filterNameElement = span.querySelector('.filterName');
              const filterValueElement = span.querySelector('.filterValue');

              // Update the filter display
              if (filterNameElement) {
                  filterNameElement.textContent = humanReadable;
              }
              if (filterValueElement) {
                  filterValueElement.setAttribute('title', humanReadable); // Update the tooltip
                  filterValueElement.textContent = humanReadable;
              }
              // document.addEventListener("turbolinks:load", humanReadableFilters(rawSearchParams));
              // document.addEventListener("ajax:success", humanReadableFilters(rawSearchParams));
          }
      });
      
      function humanReadableFilters(searchParams) {
          const filterDescriptions = [];
          
          // Decode HTML entities (e.g. &quot; -> ")
          let txt = document.createElement("textarea");
          txt.innerHTML = searchParams;
          searchParams = txt.value;

          // 0. Pre-process: Remove internal "records without dates" clause
          // This clause is: OR (*:* NOT date_created_tesim:*)
          // We remove it so it doesn't show up in the UI
          searchParams = searchParams.replace(/\s*OR\s*\(\*:\*\s*NOT\s*date_created_tesim:\*\)/g, '');

          // 1. Pre-process: Collapse "Any Field" query groups
          // The pattern is a group of ORs across many fields. We look for the start (abstract_tesim) and end (digital_object_identifier_tesim)
          // and extract the value.
          // Example: (abstract_tesim:*Michael* OR ... OR digital_object_identifier_tesim:*Michael*)
          // We use a non-greedy match for the content in between
          let processedParams = searchParams.replace(/\(abstract_tesim:(.*?) OR .*?digital_object_identifier_tesim:.*?\)/g, (match, val) => {
             // Extract the value from the first field match
             // val is captured from abstract_tesim:VAL
             return `Any_Field:${val}`;
          });

          // 2. Main Regex to parse fields
          // Supports _tesim, _sim, _ssort, and our custom _Field
          // Handles escaped characters in value (e.g. Michael\ Davitt)
          let matches = [...processedParams.matchAll(/\(?([^:()]+)(?:_(?:te?sim|ssort|sim)|_Field):([*"\[]?)((\\.|[^*\]"])+)([*"\]]?)\)?/g)];
          
          // Match logical operators (AND, OR, NOT)
          let operators = [...processedParams.matchAll(/\s+(AND|OR|NOT)\s+/g)].map(op => op[1]);

          if (matches.length === 0) {
              return searchParams;
          }

          // 3. Post-process: Merge consecutive filters for the same field and operator
          // This turns "Copyright contains 'michael' AND Copyright contains 'davitt'" 
          // into "Copyright contains 'michael davitt'"
          let mergedMatches = [];
          matches.forEach((match, index) => {
              let field = match[1].replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
              let rawQuery = match[3];
              let prefix = match[2], suffix = match[5];
              let operator = "contains";
              
              // Unescape the query value
              let query = rawQuery.replace(/\\(.)/g, '$1');

              if (field === "Any") field = "Any Field";

              // Determine operator
              if (prefix === '*' && suffix === '*') operator = "contains";
              else if (suffix === '*') operator = "starts with";
              else if (prefix === '"' && suffix === '"') operator = "equals";

              // Check if we can merge with the previous item
              let lastItem = mergedMatches[mergedMatches.length - 1];
              if (lastItem && lastItem.field === field && lastItem.operator === operator && operator === "contains") {
                  // Append current query to the previous one
                  lastItem.query += " " + query;
              } else {
                  // Add new item ONLY if field and query are valid
                  if (field && query) {
                      mergedMatches.push({
                          field: field,
                          operator: operator,
                          query: query,
                          isDate: (field === "Date Created" && prefix === "[" && suffix === "]")
                      });
                  }
              }
          });

          // 4. Generate Descriptions
          mergedMatches.forEach((item) => {
              let description = "";
              if (item.isDate) {
                  // Date logic (preserved)
                  let dateRange = item.query.split("TO");
                  if (dateRange.length === 2) {
                      dateRange = dateRange.map(year => {
                          year = year.trim();
                          if (year.startsWith('-')) return `${Math.abs(year)} BCE`;
                          return `${Math.abs(year)} CE`;
                      });
                      description = `${item.field} From ${dateRange[0]} To ${dateRange[1]}`;
                  } else {
                      if (item.query.startsWith('-')) description = `${item.field} ${Math.abs(item.query)} BCE`;
                      else description = `${item.field} ${Math.abs(item.query)} CE`;
                  }
              } else {
                  description = `${item.field} ${item.operator} "${item.query}"`;
              }
              
              if (description && description.trim() !== "") {
                  filterDescriptions.push(description);
              }
          });

          return filterDescriptions.join(' AND ');
      }




  });
</script>

<script type="text/javascript">
  function mergeFacets(primarySelector, secondarySelector, newClass, newLabel) {
    const primaryPanel = document.querySelector(primarySelector);
    const secondaryPanel = document.querySelector(secondarySelector);

    if (!primaryPanel && !secondaryPanel) {
      return;
    }

    // Check if any of the original facets were open
    const wasOpen = (primaryPanel && primaryPanel.querySelector('.facet-content').classList.contains('in')) || 
                    (secondaryPanel && secondaryPanel.querySelector('.facet-content').classList.contains('in'));

    // Create merged panel
    const mergedPanel = document.createElement("div");
    mergedPanel.classList.add("panel", "panel-default", "facet_limit", newClass);

    let facetList = "";
    if (primaryPanel) {
      facetList += primaryPanel.querySelector(".facet-values").innerHTML;
    }
    if (secondaryPanel) {
      facetList += secondaryPanel.querySelector(".facet-values").innerHTML;
    }

    mergedPanel.innerHTML = `
      <div class="collapse-toggle panel-heading" aria-expanded="${wasOpen}" data-toggle="collapse" data-target="#facet-${newClass}">
        <h3 class="panel-title facet-field-heading">
          <a data-turbolinks="false" data-no-turbolink="true" href="#">${newLabel}</a>
        </h3>
      </div>
      <div id="facet-${newClass}" class="panel-collapse facet-content collapse ${wasOpen ? 'in' : ''}" aria-expanded="${wasOpen}">
        <div class="panel-body">
          <ul class="facet-values list-unstyled">
            ${facetList}
          </ul>
        </div>
      </div>
    `;

    if (primaryPanel) {
      primaryPanel.parentNode.insertBefore(mergedPanel, primaryPanel);
    } else if (secondaryPanel) {
      secondaryPanel.parentNode.insertBefore(mergedPanel, secondaryPanel);
    }

    // Remove original panels
    if (primaryPanel) primaryPanel.remove();
    if (secondaryPanel) secondaryPanel.remove();
  }

  function applyFacetMerging() {
    mergeFacets(".blacklight-keyword_sim", ".blacklight-subject_sim", "blacklight-keyword_subject", "Keyword/Subject");
    mergeFacets(".blacklight-creator_sim", ".blacklight-contributor_sim", "blacklight-creator_contributor", "Creator/Contributor");
  }

  // Run on initial page load
  document.addEventListener("DOMContentLoaded", applyFacetMerging);

  // Re-run on AJAX navigation (Blacklight uses Turbolinks/AJAX)
  document.addEventListener("turbolinks:load", applyFacetMerging);
  document.addEventListener("ajax:success", applyFacetMerging);
</script>


