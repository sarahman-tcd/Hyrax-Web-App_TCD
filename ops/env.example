ACTION_MAILER_DEFAULT_FROM='no-reply@datacollaboratory.org'
ADMIN_MAILER_ADMIN_EMAIL='trinity-hyrax@dibbs.rutgers.edu'
ADMIN_MAILER_DEFAULT_FROM='no-reply@datacollaboratory.org'
ADMIN_MAILER_LOGIN_URL='trinity.docker'
DB_ADAPTER=mysql2
DEVISE_MAILER_SENDER='trinity-hyrax@dibbs.rutgers.edu'
